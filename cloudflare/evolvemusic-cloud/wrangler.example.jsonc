{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evolvemusic-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evolvemusic-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "evolvemusic-audio"
    },
    {
      "binding": "ROOM_FILES",
      "bucket_name": "evolvemusic-room-files"
    }
  ]
}
